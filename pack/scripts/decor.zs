// Otdelka pod lak (Zavod 1.57.24, docs/decor.md): lakirovannye doski, parket, vagonka, filyonka, bakelitovye paneli,
// linoleum, fanernyy list. Chistaya stroyka. Stupeni/plity/sklony - Carpenter's Blocks (oblozhka lyubym blokom).
// Meta lakirovannykh = poroda kak u vanil'nykh dosok: 0 dub, 1 el', 2 beryoza, 3 tropicheskoe, 4 akatsiya, 5 tyomnyy dub.

mods.forestry.Carpenter.addRecipe(<zavod:planks_varnished:0> * 8, [[<minecraft:planks:0>, <minecraft:planks:0>, <minecraft:planks:0>], [<minecraft:planks:0>, null, <minecraft:planks:0>], [<minecraft:planks:0>, <minecraft:planks:0>, <minecraft:planks:0>]], <liquid:seedoil> * 200, 40);   // olifa

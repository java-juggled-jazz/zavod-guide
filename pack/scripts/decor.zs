mods.forestry.Carpenter.addRecipe(<zavod:planks_varnished:0> * 8, [[<minecraft:planks:0>, <minecraft:planks:0>, <minecraft:planks:0>], [<minecraft:planks:0>, null, <minecraft:planks:0>], [<minecraft:planks:0>, <minecraft:planks:0>, <minecraft:planks:0>]], <liquid:alkyd> * 50, 40);   // alkidnyy lak - ekonomnee vsego

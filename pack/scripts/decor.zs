// Bakelitovye paneli: chyornaya - napolnitel' sazha/ugol', korichnevaya (karbolit) - drevesnaya muka.
recipes.addShapeless(<zavod:bakelite_panel:0> * 4, [<zavod:bakelite>, <zavod:bakelite>, <zavod:bakelite>, <zavod:bakelite>, <minecraft:coal:*>]);
recipes.addShapeless(<zavod:bakelite_panel:1> * 4, [<zavod:bakelite>, <zavod:bakelite>, <zavod:bakelite>, <zavod:bakelite>, <Forestry:woodPulp>]);

// Linoleum (Uolton, 1860-e): olifa + drevesnaya massa na parusine; pigment - tsvet. Kladyotsya sloem, kak kovyor.
val canvas = <zavod:waxed_canvas>;
val pulp = <Forestry:woodPulp>;
mods.forestry.Carpenter.addRecipe(<zavod:linoleum:0> * 12, [[canvas, canvas, canvas], [pulp, <ore:dyeRed>, pulp]], <liquid:seedoil> * 250, 60);
mods.forestry.Carpenter.addRecipe(<zavod:linoleum:1> * 12, [[canvas, canvas, canvas], [pulp, <ore:dyeGreen>, pulp]], <liquid:seedoil> * 250, 60);
mods.forestry.Carpenter.addRecipe(<zavod:linoleum:2> * 12, [[canvas, canvas, canvas], [pulp, <ore:dyeBrown>, pulp]], <liquid:seedoil> * 250, 60);
mods.forestry.Carpenter.addRecipe(<zavod:linoleum:3> * 12, [[canvas, canvas, canvas], [<ore:dyeBlack>, pulp, <ore:dyeWhite>]], <liquid:seedoil> * 250, 60);

// Fanera: lushchyonyy shpon iz propariennykh bryoven + bakelitovyy kley (fenolformal'degidnyy), list-peregorodka kak steklo.
mods.forestry.Carpenter.addRecipe(<zavod:plywood> * 16, [[<ore:logWood>, <ore:logWood>, <ore:logWood>], [null, <zavod:bakelite>, null]], <liquid:water> * 500, 60);

